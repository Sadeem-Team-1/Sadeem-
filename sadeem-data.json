atedAt":1738000000000},{"id":"faq_2","q":"فين ألاقي الملخصات والمحاضرات؟","a":"كل حاجة موجودة في قسم «بنك الملخصات» في الصفحة الرئيسية: اختار المادة وهتلاقي المحاضرات والملخصات والشيتات مع زر «فتح الرابط» اللي يوديك على Google Drive مباشرة، وممكن كمان تدور على أي مادة من شريط البحث الذكي فوق.","tags":["ملخصات","محاضرات","بنك"],"source":"admin","createdAt":1738000100000},{"id":"faq_3","q":"هل الملخصات مجانية؟","a":"أيوة، كل ملخصات ومحاضرات تيم سديم مجانية بالكامل لطلاب الكلية 💙 هدفنا إن محدش يقع في المذاكرة لوحده.","tags":["مجاني","أسعار"],"source":"admin","createdAt":1738000200000},{"id":"faq_4","q":"إزاي أنضم لتيم سديم أو أتواصل معكم؟","a":"كل حاجة جوه الموقع: اسأل بوت سديم العائم 🤖 أو اضغط زر «اسأل سؤال» — سؤالك يتسجل على المنصة ويوصَل للفريق مباشرة، والإجابة تنزل هنا في الأسئلة الشائعة 💙","tags":["انضمام","تواصل","بوت","سؤال"],"source":"admin","createdAt":1738000300000},{"id":"faq_5","q":"مواعيد الامتحانات والمراجعات فين؟","a":"أي خبر أو موعد امتحان هينزل فوراً في شريط الإعلانات المتحرك أعلى الموقع 🔴 تابع الشريط باستمرار، ولو عندك سؤال محدد اسأل بوت سديم العائم 🤖.","tags":["امتحانات","مواعيد","إعلانات"],"source":"admin","featured":true,"createdAt":1738000400000},{"id":"faq_6","q":"إنت مين؟ وإزاي أسأل سؤال مش موجود هنا؟","a":"أنا سديم بوت 🤖 مساعدك الذكي في المنصة! بقدر أساعدك في: البحث عن أي ملخص أو محاضرة، نصائح المذاكرة، والأسئلة الشائعة. ولو سؤالك مش موجود هنا اكتبه في الشات — هرفعه لفريق سديم وهيترد عليه وينزل هنا في الأسئلة الشائعة 💙","tags":["البوت","مساعدة","سؤال"],"source":"admin","createdAt":1738000500000}],"questions":[],"announcements":[{"id":"ann_mwbb7lxncob90","text":"يارب زياد يدوق طعم الفرحة","type":"urgent","active":true,"createdAt":1794352603595}],"settings":{"whatsapp":"https://chat.whatsapp.com/BwZa7Qp3kDb1scbbQdudxB?mode=ems_copy_c"},"meta":{"seedVersion":7,"updatedAt":1794352603596,"freshSeed":false}}